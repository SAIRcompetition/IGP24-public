# OS/editor noise
.DS_Store
**/.DS_Store
*~
*.swp
*.swo
.vscode/
.idea/

# Python/tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local scratch space
/tmp/
/scratch/
/work/
*.tmp
*.bak
*.log
*_part[0-9][0-9].csv

# Generated local outputs
*.local.tsv

# Root-level generated files should be moved into a project subdirectory.
/*.csv
/*.tsv
/*.log

# Archived worker chunks are provenance scratch, not canonical snapshot data.
/public package/snapshots/lmfdb_degree24_2026-05-20/chunk_outputs/

# Intermediate search provenance. The repository shows only the solver code,
# the method write-ups, and the curated reference results. Generated
# candidates, raw/combined result CSVs, and per-batch reports are large and
# fully regenerable by re-running the solvers, so they are not committed.
public package/search/*/candidates/
public package/search/*/results/
public package/search/*/reports/*
!public package/search/*/reports/EXPLORATION_LOG.md
!public package/search/*/reports/STRATEGY_NOTES.md

# Per-source reference files: convenience views regenerated by
# public package/tools/build_reference_examples.py. The tracked
# baseline_*.csv already carries a `source` column.
public package/materials/local_workspace_lmfdb_novel_pairs.txt
public package/materials/local_workspace_lmfdb_novel_pairs.txt

# Intermediate per-batch raw text from the Kluners-Malle fetch.
# The consolidated km_deg*_all.txt files (or km_deg6.txt / km_deg8.txt) are the
# canonical input to km_parse.py; the per-batch slices are scratch.
public package/search/public/km_deg12.txt
public package/search/public/km_deg12_b*.txt
